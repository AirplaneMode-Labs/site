# Every text file is stored and checked out with LF, on every platform. Tests compare fixture bytes
# (canonical JSON, golden reports, signatures) byte for byte, and a CRLF checkout on Windows breaks them.
* text=auto eol=lf

# Binary files are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.wasm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.gz binary
